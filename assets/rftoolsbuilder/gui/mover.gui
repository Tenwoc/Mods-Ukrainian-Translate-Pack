window {
    size(180,152)

    binddata('name', 'name', 'rftoolsbuilder:mover_data')
    bind('connections', 'connections')
    binddata('down', 'down', 'rftoolsbuilder:mover_data')
    binddata('up', 'up', 'rftoolsbuilder:mover_data')
    binddata('north', 'north', 'rftoolsbuilder:mover_data')
    binddata('south', 'south', 'rftoolsbuilder:mover_data')
    binddata('west', 'west', 'rftoolsbuilder:mover_data')
    binddata('east', 'east', 'rftoolsbuilder:mover_data')

    panel('','positional') {
        bg1('rftoolsbuilder:textures/gui/mover.png')

        label('', 'Connections:') {
            hint(10,10,70,14)
            horizalign('ALIGN_LEFT')
        }
         label('connections', '') {
             hint(80,10,35,14)
             horizalign('ALIGN_LEFT')
         }

        label('', 'Name:') {
            hint(10,25,35,14)
            horizalign('ALIGN_LEFT')
        }
        textfield('name') {
            hint(40,25,60,14)
            tooltips('Встановити назву цього переміщувача')
        }

        panel('','horizontal') {
            hint(2,40,160,20)
            spacing(1)
            label('', 'Excluded:')
            togglebutton('down','D') {
                tooltips('Увімкнути/вимкнути нижній напрямок')
            }
            togglebutton('up','U') {
                tooltips('Увімкнути/вимкнути верхній напрямок')
            }
            togglebutton('north','N') {
                tooltips('Увімкнути/вимкнути північний напрямок')
            }
            togglebutton('south','S') {
                tooltips('Увімкнути/вимкнути південний напрямок')
            }
            togglebutton('west','W') {
                tooltips('Увімкнути/вимкнути західний напрямок')
            }
            togglebutton('east','E') {
                tooltips('Увімкнути/вимкнути східний напрямок')
            }
        }
    }
}
